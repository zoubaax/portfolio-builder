# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Neon PostgreSQL Database Connection
# Get this from your Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication Keys
# Get these from Clerk Dashboard (https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Provider API Keys (At least one recommended)
# 1. Groq (Ultra-fast chat inference): https://console.groq.com
GROQ_API_KEY=gsk_...
# 2. Mistral ($50 free credit): https://console.mistral.ai
MISTRAL_API_KEY=...
# 3. NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...

# Default Active AI Provider (groq | mistral | nvidia)
DEFAULT_AI_PROVIDER=groq
